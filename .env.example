# ==============================================================================
# Upstage 해커톤 서비스 환경 설정 파일 (.env)
# 
# [빠른 시작 방법]
#   1. 이 파일(.env.example)을 복사하여 같은 위치에 .env 파일로 저장합니다.
#      (터미널: copy .env.example .env 또는 cp .env.example .env)
#   2. 아래 UPSTAGE_API_KEY 에 팀원 본인의 Upstage API 키를 입력합니다.
#   3. 가상환경 활성화 후 python app.py 실행 -> http://127.0.0.1:5001 접속
# ==============================================================================

# [필수] Upstage 콘솔 API 키 (up_... 형식)
UPSTAGE_API_KEY=your_upstage_api_key_here

# [필수] Upstage Studio 워크플로우 1 에이전트 설정
# (기사 작성 + 팩트 추출 + Validate 검증 노드가 결합된 워크플로우)
UPSTAGE_AGENT_ID=agt_GG3zVpMqhdZ6CshaSfg6Um
# 비워두면 항상 Upstage Studio 최신 배포 버전을 자동으로 사용합니다
UPSTAGE_CONFIG_ID=
UPSTAGE_PROJECT_ID=proj_DRxifgzqyygzavzHqaZR3g

# [선택] 서버 실행 호스트 및 포트
PORT=5001
HOST=127.0.0.1
DEBUG=0
